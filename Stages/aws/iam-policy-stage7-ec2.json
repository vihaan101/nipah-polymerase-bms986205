{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListNipahPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::nipah-archive",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["nipah/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteNipahObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::nipah-archive/nipah/*"
    }
  ]
}
